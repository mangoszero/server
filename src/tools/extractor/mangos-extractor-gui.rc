#include <windows.h>
#include "revision_data.h"

/* Numeric 1, not a named resource: the shell shows the LOWEST-numbered icon, and a
   string name sorts after every number. This is the one Explorer draws. */
1 ICON DISCARDABLE "mangos-extractor.ico"

/* The header badge, decoded at run time: a JPEG is not a BITMAP resource, so it
   travels as raw bytes and OleLoadPicture turns it into something drawable. */
MANGOSLOGO RCDATA DISCARDABLE "mangos-tools.jpg"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION     VER_FILEVERSION
    PRODUCTVERSION  VER_PRODUCTVERSION
    FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
    FILEFLAGS       VS_FF_DEBUG
#else
    FILEFLAGS       0x0L
#endif
    FILEOS          VOS_NT_WINDOWS32
    FILETYPE        VFT_APP
    FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName",      VER_COMPANY_NAME_STR
            VALUE "FileDescription",  "MaNGOS client baker"
            VALUE "FileVersion",      VER_FILEVERSION_STR
            VALUE "InternalName",     "mangos-extractor-gui"
            VALUE "LegalCopyright",   VER_LEGALCOPYRIGHT_STR
            VALUE "OriginalFilename", "mangos-extractor-gui.exe"
            VALUE "ProductName",      "MaNGOS"
            VALUE "ProductVersion",   VER_PRODUCTVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END
