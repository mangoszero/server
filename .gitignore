#
# NOTE! Don't add files that are generated in specific
# subdirectories here. Add them in the ".gitignore" file
# in that subdirectory instead.
#
# NOTE! Please use 'git-ls-files -i --exclude-standard'
# command after changing this file, to see if there are
# any tracked files which get ignored after the change.

# Placeholder files for directories needed to be inside git but empty
!.gitignore
!.gitattributes

# JetBrains - project settings
/.idea/

# Eclipse - project settings
/.project
/.settings
/.buildpath
/.externalToolBuilders

# Sublime Text 2 - project files
/*.sublime-build
/*.sublime-project
/*.sublime-workspace

# Visual Studio Code - project settings
.vscode

# Numerous always-ignore extensions
*.a
*.bak
*.bin
*.diff
*.err
*.gz
*.lo
*.log
*.o
*.o.*
*.orig
*.patch
*.rej
*.so
*.so.dbg
*.swo
*.swp
*.vi
*~
callgrind.out.*

# OS or Editor folders
.DS_Store
.cache
.project
.settings
.tmproj
nbproject
Thumbs.db

# Configuration files to be customized

# Build directories. Anchored at the root: an unanchored "build" also swallows
# dep/recastnavigation/RecastDemo/Build on case-insensitive filesystems.
/bin/
_build
/build/
/install/
/database/

# Generated files
*.ncb
*.opensdf
*.sdf
*.sln.cache
*.suo
*.user
*.vsp
cmake_install.cmake
CMakeCache.txt
CMakeFiles
ipch

# EasyBuild created debug files
cmake.cmd
msbuild.cmd

# recastnavigation directory needs exception
!/dep/recastnavigation/RecastDemo/Build/

/src/tools/Extractor_Binaries/*.exe

# AI assistant scratch. Agent config belongs to the workspace, not to a core;
# docs/superpowers was a pure artifact (it ignored its own entire contents).
.claude/
docs/superpowers/

# Compiler caches. CCACHE_DIR/SCCACHE_DIR in the CI workflows point outside the
# checkout, which is the actual fix; this is a safety net, because the cache
# action picks its own directory if it does not honour those. Without it the
# "working tree is clean" guard fails on the cache rather than on a real change.
.ccache/
.sccache/

# Generated by GenRevision; 02 writes it to the build tree instead.
src/shared/revision_data.h
